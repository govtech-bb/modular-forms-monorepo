<html>
  <head>
    <meta charset="utf-8" />
    <style>
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
        line-height: 1.6;
        color: #1a202c;
        margin: 0;
        padding: 0;
        background-color: #f7fafc;
      }
      .wrapper {
        max-width: 680px;
        margin: 32px auto;
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
      }
      .header {
        background-color: #00267f;
        color: #ffffff;
        padding: 28px 32px;
      }
      .header h1 {
        margin: 0 0 6px;
        font-size: 22px;
        font-weight: 700;
        line-height: 1.3;
      }
      .header p {
        margin: 0;
        font-size: 14px;
        opacity: 0.85;
      }
      .body {
        padding: 28px 32px;
      }
      .intro {
        font-size: 15px;
        color: #2d3748;
        margin: 0 0 24px;
      }
      .meta {
        background-color: #f7fafc;
        border-radius: 6px;
        padding: 16px 20px;
        margin: 0 0 24px;
      }
      .meta table {
        width: 100%;
        border-collapse: collapse;
      }
      .meta td {
        padding: 4px 0;
        font-size: 13px;
        vertical-align: top;
      }
      .meta .meta-label {
        color: #4a5568;
        font-weight: 600;
        width: 140px;
        padding-right: 12px;
      }
      .section {
        margin-bottom: 28px;
      }
      .section-title {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #718096;
        margin: 0 0 10px;
        padding-bottom: 6px;
        border-bottom: 1px solid #e2e8f0;
      }
      table.fields {
        width: 100%;
        border-collapse: collapse;
      }
      table.fields td {
        padding: 9px 0;
        font-size: 14px;
        vertical-align: top;
        border-bottom: 1px solid #edf2f7;
      }
      table.fields tr:last-child td {
        border-bottom: none;
      }
      .field-label {
        color: #718096;
        width: 42%;
        padding-right: 16px;
        font-weight: 500;
      }
      .field-value {
        color: #1a202c;
      }
      .footer {
        background-color: #edf2f7;
        padding: 20px 32px;
        font-size: 12px;
        color: #718096;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="header">
        <h1>New submission received</h1>
        <p>{{formTitle}}</p>
      </div>

      <div class="body">
        <p class="intro">
          A citizen has submitted this form. A copy of the submitted values is
          included below for your records.
        </p>

        <div class="meta">
          <table>
            <tr>
              <td class="meta-label">Reference</td>
              <td>{{submissionId}}</td>
            </tr>
            <tr>
              <td class="meta-label">Submitted at</td>
              <td>{{submittedAt}}</td>
            </tr>
            {{#if submitterEmail}}
              <tr>
                <td class="meta-label">Submitter email</td>
                <td>{{submitterEmail}}</td>
              </tr>
            {{/if}}
          </table>
        </div>

        {{#each sections}}
          <div class="section">
            <div class="section-title">{{title}}</div>
            <table class="fields">
              {{#each fields}}
                <tr>
                  <td class="field-label">{{label}}</td>
                  <td class="field-value">{{value}}</td>
                </tr>
              {{/each}}
            </table>
          </div>
        {{/each}}
      </div>

      <div class="footer">
        Sent to
        {{contactDetails.title}}
        ({{contactDetails.email}})
      </div>
    </div>
  </body>
</html>